{
  "server": {
    "port": 3001,
    "dataRoot": "data",
    "corsOrigins": [
      "http://localhost:5177",
      "http://127.0.0.1:5177"
    ]
  },
  "web": {
    "origin": "http://localhost:5177",
    "apiBase": ""
  },
  "runner": {
    "headlessWorkers": 4,
    "headedWorkers": 1,
    "maxWorkers": 20
  },
  "browser": {
    "openTimeoutMs": 30000
  },
  "steps": {
    "timeouts": {
      "navigation": 20000,
      "action": 2000,
      "wait": 1000
    }
  },
  "agent": {
    "protocol": "chat-completions",
    "provider": "corp",
    "model": "test-agent",
    "baseUrl": "",
    "opencodePath": "",
    "playwrightMcpPath": "",
    "timeoutMs": 180000
  }
}
